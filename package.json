{
  "name": "playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "api": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep @API",
    "api:smoke": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep \"@API.*@Smoke\"",
    "api:regression": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep \"@API.*@Regression\"",
    "api:negative": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep \"@API.*@Negative\"",
    "e2e": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep @E2E",
    "e2e:smoke": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep \"@E2E.*@Smoke\"",
    "e2e:regression": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep \"@E2E.*@Regression\"",
    "e2e:negative": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep \"@E2E.*@Negative\"",
    "smoke": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep @Smoke",
    "regression": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test --grep @Regression",
    "debug": "npx playwright test --ui",
    "test": "cross-env NODE_ENV=dev ENVIRONMENT=test playwright test",
    "allureOpen": "allure open",
    "allureGenerate": "allure generate"
  },
